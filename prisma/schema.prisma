}

model EmployeeHistory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  action  String
  message String
  metadata Json?

  actorId String?
  actor   User?   @relation("EmployeeHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
  @@index([createdAt])
}

/// Permanent enterprise audit trail — never deleted.
model AuditLog {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Who (nullable for system / failed-auth cases)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String?

  /// What
  module     String
  action     String
  entityType String?
  entityId   String?
  summary    String?

  oldValue Json?
  newValue Json?

  /// success | failed | pending | warning
  status String @default("success")

  /// Request context
  ipAddress String?
  userAgent String?
  device    String?

  metadata Json?

  /// When
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, module])
  @@index([companyId, action])
  @@index([companyId, userId])
  @@index([companyId, status])
  @@index([entityType, entityId])
  @@index([ipAddress])
}

/// Enterprise change history — immutable version snapshots per record
model EntityVersion {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String

  /// Monotonic per (companyId, entityType, entityId)
  versionNumber Int

  recordName String

  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String?

  /// CREATE | UPDATE | RESTORE | ARCHIVE | UNARCHIVE | DELETE
  action String

  /// [{ field, before, after }]
  changedFields Json

  beforeValue Json?
  afterValue  Json?

  comment String?

  /// Optional link to permanent AuditLog row
  auditLogId String?

  createdAt DateTime @default(now())

  @@unique([companyId, entityType, entityId, versionNumber])
  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, action])
  @@index([companyId, userId])
  @@index([auditLogId])
}

/// AI Assistant conversation thread (per user)
model AiConversation {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String?

  messages AiMessage[]

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([companyId, userId, updatedAt])
}

model AiMessage {
  id String @id @default(cuid())

  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// user | assistant | system
  role String

  content String

  /// Parsed intent / structured payload
  intent   String?
  metadata Json?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// Cached AI insights for dashboard widgets
model AiInsight {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// sales | purchases | inventory | profit | customers | suppliers | employees | warehouses | health
  category String
  title    String
  summary  String
  severity String @default("info")
  href     String?
  score    Float?
  payload  Json?

  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([companyId, category, createdAt])
  @@index([companyId, expiresAt])
}

/// Active AI-generated business alerts
model AiAlert {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// low_stock | overstock | unpaid_invoices | late_payments | unusual_sales | negative_margin | duplicate_records
  kind     String
  title    String
  message  String
  severity String @default("warning")
  href     String?
  entityType String?
  entityId   String?
  payload    Json?

  /// open | acknowledged | resolved
  status String @default("open")

  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, status, createdAt])
  @@index([companyId, kind])
}

/// Workflow automation rules (reports, reminders, notifications)
model AiAutomationRule {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name    String
  /// report | notification | reminder | next_action
  kind    String
  enabled Boolean @default(true)

  /// cron-like: daily | weekly | monthly | on_alert
  schedule String @default("daily")
  config   Json

  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, enabled])
  @@index([companyId, nextRunAt])
}

/// Auditable salary adjustment; the employee's base salary is never mutated.
model SalaryDeduction {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date DateTime @default(now()) @db.Date
  reason String
  source String
  amount Decimal @db.Decimal(14, 2)
  salaryPeriod String
  approved Boolean @default(true)
  createdById String?
  createdBy User? @relation("SalaryDeductionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  notes String?
  createdAt DateTime @default(now())
  @@index([companyId, salaryPeriod])
  @@index([employeeId, salaryPeriod])
}

model EmployeePerformance {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId String
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  period String
  score Int
  attendanceContribution Int?
  notes String?
  reviewerId String?
  reviewer User? @relation("PerformanceReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([companyId, period])
  @@index([employeeId, period])
}

/// User-facing application release notes, scoped to a company.
model AppRelease {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  version String
  title String
  releaseDate DateTime @db.Date
  summary String
  changes String?
  publishedAt DateTime?
  isCurrent Boolean @default(false)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reads AppReleaseRead[]
  @@unique([companyId, version])
  @@index([companyId, publishedAt])
}

model AppReleaseRead {
  id String @id @default(cuid())
  releaseId String
  release AppRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt DateTime @default(now())
  @@unique([releaseId, userId])
  @@index([userId, readAt])
}
