/// Permanent invoice snapshot created from every completed sale. Never hard-deleted.
model Invoice {
  id String @id @default(cuid())

  invoiceNo String

  saleId String @unique
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Restrict)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  templateId String?
  template   InvoiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  /// Company snapshot at invoice creation
  companyName          String
  companyEmail         String
  companyPhone         String?
  companyAddress       String?
  companyWebsite       String?
  companyLogo          String?
  companyTaxNumber     String?
  companyInvoiceHeader String?
  companyInvoiceFooter String?
  companySignature     String?
  companyStamp         String?

  /// Customer snapshot
  customerName    String
  customerCode   String
  customerPhone  String?
  customerEmail  String?
  customerAddress String?

  warehouseName String
  warehouseCode String

  createdByName String?

  subtotal   Decimal @db.Decimal(12, 2)
  discount   Decimal @default(0) @db.Decimal(12, 2)
  tax        Decimal @default(0) @db.Decimal(12, 2)
  grandTotal Decimal @db.Decimal(12, 2)
  paidAmount Decimal? @db.Decimal(12, 2)
  remainingBalance Decimal? @db.Decimal(12, 2)

  paymentMethod PaymentMethod @default(CASH)
  paymentNote   String?

  notes String?

  /// Business date of the invoice (from sale)
  invoiceDate DateTime
  /// Clock time captured at creation
  invoiceTime DateTime @default(now())

  status InvoiceStatus @default(ACTIVE)
  deletedAt   DateTime?
  deletedById String?

  items        InvoiceItem[]
  printHistory InvoicePrintEvent[]
  pdfHistory   InvoicePdfEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, createdAt])
  @@index([companyId, deletedAt])
  @@unique([companyId, invoiceNo])
  @@index([companyId, invoiceDate])
  @@index([customerId])
}

