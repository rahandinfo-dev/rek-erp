/// Append-only stock ledger. Rows are never deleted or updated.
model InventoryTransaction {
  id String @id @default(cuid())

  type InventoryTransactionType

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  /// Signed or absolute quantity of this movement (always positive; sign via type).
  quantity Decimal @db.Decimal(12, 2)

  previousQty Decimal? @db.Decimal(12, 2)
  newQty      Decimal? @db.Decimal(12, 2)

  unitCost Decimal? @db.Decimal(12, 2)

  referenceId   String?
  referenceType String?
  referenceNo   String?

  reason String?
  notes  String?

  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Counterpart warehouse for transfers (destination on OUT, source on IN).
  relatedWarehouseId String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@index([companyId, createdAt])
  @@index([companyId, warehouseId])
  @@index([companyId, productId, createdAt])
  @@index([userId])
  @@index([referenceNo])
}

/// Per-warehouse on-hand balance (source of truth for transfers).
