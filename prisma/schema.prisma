// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Prisma 7 requires an explicit output path (the client is no longer written
// into node_modules). Output lives outside `app/` so Next.js never scans the
// generated files as part of the route tree. The folder is gitignored, so
// `prisma generate` runs from `postinstall` and `prebuild` (local + Vercel).
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  SALE_RETURN
  PURCHASE_RETURN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  PRODUCT_CREATE
  PRODUCT_DELETE
  RESTORE
}

enum PurchaseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum InvoiceSize {
  A4
  THERMAL
  RECEIPT
}

enum InvoiceDocType {
  SALE
  PURCHASE
  GENERIC
}

enum NotificationCategory {
  PRODUCT
  INVENTORY
  SALE
  PURCHASE
  CUSTOMER
  SUPPLIER
  WAREHOUSE
  INVOICE
  EMPLOYEE
  SYSTEM
  ERROR
  WARNING
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_LEAVE
  ABSENT
  LATE
  TERMINATED
}

enum EmployeeRole {
  ADMIN
  MANAGER
  STAFF
  ACCOUNTANT
  HR
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
  HALF_DAY
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalaryStatus {
  PENDING
  PAID
  CANCELLED
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum InvoiceStatus {
  ACTIVE
  VOID
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CREDIT
  DIGITAL
  OTHER
}

/// Commercial subscription period carried by a redeemed license code.
enum SubscriptionPlan {
  ONE_MONTH
  THREE_MONTHS
  ONE_YEAR
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  CANCELLED
  SUSPENDED
}

enum SubscriptionActionSource {
  CUSTOMER
  ADMIN
  SYSTEM
}

/// A code is never reusable after it leaves UNUSED, including after revocation.
enum LicenseCodeStatus {
  UNUSED
  USED
  EXPIRED
  REVOKED
}

enum SubscriptionLifecycleEventType {
  ACTIVATED
  RENEWED
  EXPIRED
  CANCELLED
  REVOKED
}

model Company {
  id      String  @id @default(cuid())
  name    String
  /// Short company code for document numbering (e.g. CEM)
  code    String?
  email   String  @unique
  phone   String?
  address String?
  website String?
  logo    String?

  taxNumber     String?
  invoiceHeader String?
  invoiceFooter String?
  signature     String?
  stamp         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  settings Settings?

  warehouses            Warehouse[]
  categories            Category[]
  units                 Unit[]
  brands                Brand[]
  products              Product[]
  suppliers             Supplier[]
  customers             Customer[]
  purchases             Purchase[]
  inventoryTransactions InventoryTransaction[]
  warehouseStocks       WarehouseStock[]
  stockTransfers        StockTransfer[]
  sales                 Sale[]
  invoices              Invoice[]
  invoiceTemplates      InvoiceTemplate[]
  notifications         Notification[]
  employees             Employee[]
  attendances           Attendance[]
  leaveRequests         LeaveRequest[]
  salaryPayments        SalaryPayment[]
  employeeHistories     EmployeeHistory[]
  auditLogs             AuditLog[]
  formDrafts            FormDraft[]
  sessionRecoveries     SessionRecovery[]
  navigationHistories  NavigationHistory[]
  workspaceStates       WorkspaceState[]
  favoriteWorkspaces    FavoriteWorkspace[]
  favoriteGroups        FavoriteGroup[]
  favoriteItems         FavoriteItem[]
  searchPrefs           SearchPrefs[]
  dashboardWorkspaces   DashboardWorkspace[]
  keyboardPrefs         KeyboardPrefs[]
  saveGuardPrefs        SaveGuardPrefs[]
  saveAuditEvents       SaveAuditEvent[]
  draftVersions         DraftVersion[]
  draftAuditEvents      DraftAuditEvent[]
  recycleBinEntries     RecycleBinEntry[]
  recycleBinPrefs       RecycleBinPrefs[]
  bulkJobs              BulkJob[]
  entityMetas           EntityMeta[]
  numberingRules        NumberingRule[]
  numberingCounters     NumberingCounter[]
  quickActionPrefs      QuickActionPrefs[]
  entityVersions        EntityVersion[]
  aiConversations       AiConversation[]
  aiInsights            AiInsight[]
  aiAlerts              AiAlert[]
  aiAutomationRules     AiAutomationRule[]
  pushSubscriptions     PushSubscription[]
  notificationPushPrefs NotificationPushPrefs[]
  appReleases           AppRelease[]
  salaryDeductions      SalaryDeduction[]
  employeePerformances  EmployeePerformance[]
  subscription          CompanySubscription?
  licenseCodes          LicenseCode[]
  subscriptionWarningState SubscriptionWarningState?
  subscriptionLifecycleEvents SubscriptionLifecycleEvent[]
}

model User {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  fullName String
  username String @unique
  email    String @unique
  password String
  navigationStyle String @default("SIDE_MENU")

  /// Profile avatar (Vercel Blob URL)
  avatar String?

  verified Boolean @default(false)

  otp String?

  otpExpiresAt DateTime?

  emailVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notifications Notification[]
  invoices      Invoice[]
  invoicePrints InvoicePrintEvent[]
  invoicePdfs   InvoicePdfEvent[]
  employeesCreated Employee[] @relation("EmployeeCreatedBy")
  leaveReviews     LeaveRequest[] @relation("LeaveReviewedBy")
  employeeActions  EmployeeHistory[] @relation("EmployeeHistoryActor")
  inventoryTransactions InventoryTransaction[]
  stockTransfers        StockTransfer[]
  auditLogs             AuditLog[]
  formDrafts            FormDraft[]
  sessionRecoveries     SessionRecovery[]
  navigationHistories  NavigationHistory[]
  workspaceStates       WorkspaceState[]
  favoriteWorkspaces    FavoriteWorkspace[]
  favoriteGroups        FavoriteGroup[]
  favoriteItems         FavoriteItem[]
  searchPrefs           SearchPrefs?
  dashboardWorkspaces   DashboardWorkspace[]
  keyboardPrefs         KeyboardPrefs?
  saveGuardPrefs        SaveGuardPrefs?
  saveAuditEvents       SaveAuditEvent[]
  draftVersions         DraftVersion[]
  draftAuditEvents      DraftAuditEvent[]
  recycleBinEntries     RecycleBinEntry[]
  recycleBinPrefs       RecycleBinPrefs?
  bulkJobs              BulkJob[]
  quickActionPrefs      QuickActionPrefs?
  entityVersions        EntityVersion[]
  aiConversations       AiConversation[]
  pushSubscriptions     PushSubscription[]
  notificationPushPrefs NotificationPushPrefs?
  releaseReads          AppReleaseRead[]
  salaryDeductionsCreated SalaryDeduction[] @relation("SalaryDeductionCreator")
  performanceReviewsCreated EmployeePerformance[] @relation("PerformanceReviewer")
  consumedLicenseCodes LicenseCode[] @relation("LicenseCodeUsedByUser")
  cancelledSubscriptions CompanySubscription[] @relation("SubscriptionCancelledBy")
  subscriptionLifecycleEvents SubscriptionLifecycleEvent[]
}

/// Platform administrator. This identity is deliberately separate from tenant
/// User records and can never inherit company access.
model SuperAdmin {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  mustChangePassword Boolean @default(true)
  active Boolean @default(true)
  lastLoginAt DateTime?
  passwordChangedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions SuperAdminSession[]
  auditLogs SuperAdminAuditLog[]
  licenseCodesCreated LicenseCode[] @relation("LicenseCodeCreatedBySuperAdmin")
  notifications SuperAdminNotification[]
}

model SuperAdminSession {
  id String @id @default(cuid())
  superAdminId String
  superAdmin SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  tokenHash String @unique
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([superAdminId, expiresAt])
  @@index([expiresAt])
}

model SuperAdminAuditLog {
  id String @id @default(cuid())
  superAdminId String?
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: SetNull)
  action String
  targetType String?
  targetId String?
  status String @default("success")
  metadata Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([superAdminId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

/// One current entitlement per tenant. Historical issuance and activation data
/// stays in LicenseCode and in the immutable AuditLog ledger.
model CompanySubscription {
  id String @id @default(cuid())

  companyId String @unique
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  plan SubscriptionPlan
  status SubscriptionStatus @default(ACTIVE)
  activatedAt DateTime @default(now())
  expiresAt DateTime?

  /// The code that most recently established or extended the entitlement.
  licenseCodeId String? @unique
  licenseCode LicenseCode? @relation("CurrentSubscriptionLicense", fields: [licenseCodeId], references: [id], onDelete: SetNull)

  cancelledAt DateTime?
  cancelledByUserId String?
  cancelledByUser User? @relation("SubscriptionCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledFromPlan SubscriptionPlan?
  cancelledFromStatus SubscriptionStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, expiresAt])
}

/// Only a keyed one-way hash is persisted. Plaintext codes exist only in the
/// server response that creates an export and are never written to application data.
model LicenseCode {
  id String @id @default(cuid())

  codeHash String @unique
  plan SubscriptionPlan

  companyId String?
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  usedByUserId String?
  usedByUser User? @relation("LicenseCodeUsedByUser", fields: [usedByUserId], references: [id], onDelete: SetNull)

  status LicenseCodeStatus @default(UNUSED)
  activatedAt DateTime?
  expiresAt DateTime?
  usedAt DateTime?

  createdBySuperAdminId String?
  createdBySuperAdmin SuperAdmin? @relation("LicenseCodeCreatedBySuperAdmin", fields: [createdBySuperAdminId], references: [id], onDelete: SetNull)
  currentSubscription CompanySubscription? @relation("CurrentSubscriptionLicense")
  lifecycleEvents SubscriptionLifecycleEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, plan, createdAt])
  @@index([companyId, status])
  @@index([usedByUserId, usedAt])
  @@index([expiresAt])
}

/// Persistent de-duplication state for the once-per-day five-day renewal warning.
model SubscriptionWarningState {
  id String @id @default(cuid())
  companyId String @unique
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  subscriptionId String?
  warningBucket String?
  lastNotifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Immutable subscription lifecycle evidence. No ERP business records are touched.
model SubscriptionLifecycleEvent {
  id String @id @default(cuid())
  companyId String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  licenseCodeId String?
  licenseCode LicenseCode? @relation(fields: [licenseCodeId], references: [id], onDelete: SetNull)
  subscriptionId String?
  type SubscriptionLifecycleEventType
  actionSource SubscriptionActionSource @default(SYSTEM)
  previousPlan SubscriptionPlan?
  previousStatus SubscriptionStatus?
  plan SubscriptionPlan?
  status SubscriptionStatus?
  activatedAt DateTime?
  expiresAt DateTime?
  finalizedAt DateTime?
  durationDays Int?
  bonusDays Int @default(0)
  codeFingerprint String?
  reason String?
  metadata Json?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([licenseCodeId, createdAt])
  @@index([subscriptionId, createdAt])
}

/// Platform-admin inbox entries. These never include plaintext activation codes.
model SuperAdminNotification {
  id String @id @default(cuid())
  superAdminId String?
  superAdmin SuperAdmin? @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  kind String
  title String
  message String
  metadata Json?
  readAt DateTime?
  createdAt DateTime @default(now())

  @@index([superAdminId, createdAt])
  @@index([kind, createdAt])
}

/// Soft-deleted records awaiting restore or permanent purge
model RecycleBinEntry {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Who deleted (nullable for system)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName String?

  moduleKey  String
  entityType String
  entityId   String
  name       String
  reason     String?

  /// deleted | restored | purged
  status String @default("deleted")

  relatedJson Json?
  metadata    Json?

  deletedAt  DateTime @default(now())
  expiresAt  DateTime
  restoredAt DateTime?
  purgedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, entityType, entityId])
  @@index([companyId, status, deletedAt])
  @@index([companyId, moduleKey])
  @@index([expiresAt])
  @@index([userId])
}

model RecycleBinPrefs {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Retention days: 30 | 60 | 90
  retentionDays Int @default(30)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Enterprise bulk operation job (batch progress + undo ledger)
model BulkJob {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleKey String
  action    String

  /// pending | processing | completed | failed | cancelled | partial
  status String @default("pending")

  totalCount     Int @default(0)
  processedCount Int @default(0)
  successCount   Int @default(0)
  failedCount    Int @default(0)
  skippedCount   Int @default(0)
  cancelledCount Int @default(0)

  /// Action parameters (status, categoryId, tags, fields, format…)
  payload Json?

  /// Snapshot for undo when supported
  undoPayload Json?
  canUndo     Boolean @default(false)
  undoneAt    DateTime?

  /// Final summary for UI
  summary Json?

  /// Cancel remaining flag
  cancelRequested Boolean @default(false)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  items BulkJobItem[]

  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([userId, createdAt])
  @@index([moduleKey, action])
}

model BulkJobItem {
  id String @id @default(cuid())

  jobId String
  job   BulkJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  entityId    String
  entityLabel String?

  /// pending | processing | success | failed | skipped | cancelled
  status  String  @default("pending")
  message String?

  before Json?
  after  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, status])
  @@index([entityId])
}

/// Additive metadata for archive/tags without altering core entity schemas
model EntityMeta {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  entityType String
  entityId   String

  tags     Json?
  archived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, entityType, entityId])
  @@index([companyId, archived])
  @@index([companyId, entityType])
}

/// Per-module document numbering configuration (company-scoped)
model NumberingRule {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// products | barcodes | sales | purchases | invoices | …
  moduleKey String

  enabled Boolean @default(true)

  /// Format template with tokens, e.g. INV-{YYYY}-{SEQ:6}
  format String

  prefix     String  @default("")
  suffix     String  @default("")
  moduleCode String  @default("")

  /// Sequence pad width (used when {SEQ} without :N)
  padLength Int @default(6)

  /// First number when a new period counter is created
  startFrom Int @default(1)

  /// none | yearly | monthly
  resetPolicy String @default("yearly")

  /// Fiscal year start month 1–12 (for {FY})
  fiscalYearStartMonth Int @default(1)

  allowManualOverride Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, moduleKey])
  @@index([companyId, enabled])
}

/// Atomic sequence counters — uniqueness via unique period rows + increment
model NumberingCounter {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  moduleKey String
  /// "" | "2026" | "2026-07" depending on reset policy
  periodKey String @default("")

  /// Next value to issue
  nextValue Int @default(1)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([companyId, moduleKey, periodKey])
  @@index([companyId, moduleKey])
}

model FormDraft {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Module draft key, e.g. sale:new — unique per user
  draftKey String

  payload   Json
  savedAt   DateTime
  expiresAt DateTime

  /// Enterprise Draft Center metadata
  title     String?
  status    String  @default("draft")
  pinned    Boolean @default(false)
  archived  Boolean @default(false)
  moduleKey String?
  device    String?
  progress  Int     @default(0)
  tags      Json?
  shareToken String? @unique
  archivedAt  DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, draftKey])
  @@index([companyId, userId])
  @@index([expiresAt])
  @@index([userId, status])
  @@index([userId, pinned])
  @@index([userId, archived])
}

/// Point-in-time versions of a FormDraft (Draft Center history)
model DraftVersion {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  draftKey String
  version  Int
  payload  Json
  label    String?
  device   String?
  progress Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, draftKey, version])
  @@index([companyId, userId])
  @@index([userId, draftKey, createdAt])
}

model DraftAuditEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  draftKey String
  action   String
  detail   Json?
  device   String?
  ip       String?

  createdAt DateTime @default(now())

  @@index([companyId, userId])
  @@index([userId, draftKey])
  @@index([createdAt])
}

/// Enterprise session recovery — one unfinished session per user+module.
model SessionRecovery {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Module bucket, e.g. sales, products, settings
  moduleKey String

  /// Optional user rename in Recovery Center
  title String?

  pathname String
  search   String @default("")

  /// Encrypted UI/form snapshot { v, iv, data }
  payload Json

  /// Non-sensitive card summary (module label, counts, flags)
  summary Json

  createdAt    DateTime @default(now())
  lastEditedAt DateTime
  lastSavedAt  DateTime
  expiresAt    DateTime
  sizeBytes    Int      @default(0)

  @@unique([userId, moduleKey])
  @@index([companyId, userId])
  @@index([expiresAt])
  @@index([lastEditedAt])
}

/// Recently opened / edited / created navigation history (per user).
model NavigationHistory {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleKey  String
  entityType String?
  entityId   String?

  href      String
  title     String
  subtitle  String?
  thumbnail String?

  /// viewed | edited | created
  action String @default("viewed")

  pinned   Boolean  @default(false)
  openedAt DateTime
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, href])
  @@index([userId, openedAt])
  @@index([userId, pinned])
  @@index([expiresAt])
  @@index([companyId, userId])
}

/// Last workspace chrome (page, tab, filters, search, sort, page).
model WorkspaceState {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  pathname String
  search   String @default("")
  tab      String?
  payload  Json

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Unsaved-changes / auto-save preferences + save history mirror
model SaveGuardPrefs {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// { autoSaveEnabled, autoSaveDelayMs, history[] }
  prefs Json

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Audit trail for save / discard / conflict resolutions
model SaveAuditEvent {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceId String
  label    String
  action   String
  status   String
  device   String?
  ip       String?
  summary  Json?
  durationMs Int?

  createdAt DateTime @default(now())

  @@index([companyId, userId])
  @@index([createdAt])
}

/// Keyboard shortcuts, favorite commands, command history
model KeyboardPrefs {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// { bindings, favoriteCommandIds, commandHistory }
  prefs Json

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Per-user quick action / context menu customization
model QuickActionPrefs {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// { pinnedIds, hiddenIds, orderByModule }
  prefs Json

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// Personalized dashboard layouts (multi-dashboard, widget prefs)
model DashboardWorkspace {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  sortOrder Int     @default(0)
  isDefault Boolean @default(false)
  isActive  Boolean @default(false)

  /// Full layout JSON: widgets[], settings
  layout Json

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([userId, isActive])
  @@index([companyId, userId])
  @@unique([userId, name])
}

/// Per-user smart search history (synced across devices)
model SearchPrefs {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String @unique
